rule ruby_test
  command = ruby tests/test_vendor_firmware.rb
  description = Verify firmware decoder and input rejection
  pool = console

build test-firmware: ruby_test tests/test_vendor_firmware.rb

rule compile_test
  command = mkdir -p build && cc -std=c11 -Wall -Wextra -Werror -g -fsanitize=address,undefined -Isrc tests/test_bootstrap.c src/bootstrap.c -o $out
  description = Compile bootstrap failure-path checks

build build/test-bootstrap: compile_test tests/test_bootstrap.c src/bootstrap.c src/bootstrap.h

rule run_bootstrap_test
  command = ./build/test-bootstrap
  description = Verify RAM bootstrap transfer and failure handling
  pool = console

build test-bootstrap: run_bootstrap_test build/test-bootstrap
build test: phony test-firmware test-bootstrap test-frame test-mode test-transport test-viewer test-session test-stream-frame test-viewer-input

rule audit_firmware
  command = ruby tools/extract_firmware.rb vendor/vga2usb_bins.o_shipped build/firmware
  description = Extract and audit the pinned original VGA2USB firmware
  pool = console

build firmware-audit: audit_firmware tools/extract_firmware.rb tools/vendor_firmware.rb

rule render_firmware
  command = ruby tools/render_firmware.rb vendor/vga2usb_bins.o_shipped $out
  description = Render hash-verified original-model RAM firmware

build build/firmware.h: render_firmware vendor/vga2usb_bins.o_shipped tools/vendor_firmware.rb tools/render_firmware.rb

rule compile_driver
  command = cc -std=c11 -Wall -Wextra -Werror -g -Isrc -Ibuild src/main.c src/bootstrap.c src/capture.c src/capture_mode.c src/home_frame.c src/source_watch.c src/stream_frame.c $$(pkg-config --cflags --libs libusb-1.0) -o $out
  description = Build native original VGA2USB bringup tool

build build/vga2usb-native: compile_driver src/main.c src/bootstrap.c src/bootstrap.h src/capture.c src/capture.h src/capture_mode.c src/capture_mode.h src/home_frame.c src/home_frame.h src/source_watch.c src/source_watch.h src/stream_frame.c src/stream_frame.h src/vesa_modes.h build/firmware.h
build driver: phony build/vga2usb-native build/libviewer-input.so

rule compile_viewer_input
  command = mkdir -p build && cc -std=c11 -Wall -Wextra -Werror -fPIC -shared src/viewer_input.c -ldl -o $out
build build/libviewer-input.so: compile_viewer_input src/viewer_input.c
build viewer-input: phony build/libviewer-input.so
rule compile_viewer_input_test
  command = cc -std=c11 -Wall -Wextra -Werror tests/test_viewer_input.c -ldl -o $out
build build/test-viewer-input: compile_viewer_input_test tests/test_viewer_input.c | build/libviewer-input.so
rule run_viewer_input_test
  command = SDL_VIDEODRIVER=dummy LD_PRELOAD=$$PWD/build/libviewer-input.so ./build/test-viewer-input
  pool = console
build test-viewer-input: run_viewer_input_test build/test-viewer-input build/libviewer-input.so

default test

rule compile_frame_test
  command = mkdir -p build && cc -std=c11 -Wall -Wextra -Werror -g -fsanitize=address,undefined -Isrc tests/test_home_frame.c src/home_frame.c -o $out
  description = Compile HOME frame decoder checks

build build/test-home-frame: compile_frame_test tests/test_home_frame.c src/home_frame.c src/home_frame.h

rule run_frame_test
  command = ./build/test-home-frame
  description = Verify original HOME frame segmentation and deordering
  pool = console

build test-frame: run_frame_test build/test-home-frame

rule compile_mode_test
  command = mkdir -p build && cc -std=c11 -Wall -Wextra -Werror -g -fsanitize=address,undefined -Isrc tests/test_capture_mode.c src/capture_mode.c src/home_frame.c -o $out
  description = Compile original capture-mode request checks

build build/test-capture-mode: compile_mode_test tests/test_capture_mode.c src/capture_mode.c src/capture_mode.h src/home_frame.c src/vesa_modes.h

rule run_mode_test
  command = ./build/test-capture-mode
  description = Verify original ADC overrides and complete VGA capture requests
  pool = console

build test-mode: run_mode_test build/test-capture-mode

rule compile_transport_test
  command = mkdir -p build && cc -std=c11 -Wall -Wextra -Werror -g -fsanitize=address,undefined -Isrc $$(pkg-config --cflags libusb-1.0) tests/test_capture_transport.c src/capture.c src/capture_mode.c src/home_frame.c src/source_watch.c src/stream_frame.c -o $out
  description = Compile async capture transport failure checks

build build/test-capture-transport: compile_transport_test tests/test_capture_transport.c src/capture.c src/capture_mode.c src/home_frame.c src/source_watch.c src/capture.h src/capture_mode.h src/home_frame.h src/source_watch.h src/stream_frame.c src/stream_frame.h src/vesa_modes.h

rule run_transport_test
  command = ./build/test-capture-transport
  description = Verify USB queue ordering and reject incomplete frames
  pool = console

build test-transport: run_transport_test build/test-capture-transport

rule viewer_test
  command = ruby tests/test_viewer_stream.rb
  description = Verify complete live-viewer frame packets in both VGA modes
  pool = console
build test-viewer: viewer_test tests/test_viewer_stream.rb tools/view-live.sh build/test-stream-frame build/libviewer-input.so

rule compile_session_test
  command = cc -std=c11 -Wall -Wextra -Werror -g -fsanitize=address,undefined -Isrc -Ibuild $$(pkg-config --cflags libusb-1.0) tests/test_capture_session.c src/bootstrap.c -o $out
  description = Compile stream USB-session lifecycle regression
build build/test-capture-session: compile_session_test tests/test_capture_session.c src/main.c src/capture.h src/capture_mode.h src/bootstrap.c src/bootstrap.h build/firmware.h
rule session_test
  command = ./build/test-capture-session
  description = Verify fresh USB session after observed VGA loss
  pool = console
build test-session: session_test build/test-capture-session

include tests/stream-frame.ninja
