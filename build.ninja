rule ruby_test
  command = ruby tests/test_vendor_firmware.rb
  description = Verify firmware decoder and input rejection
  pool = console

build test-firmware: ruby_test tests/test_vendor_firmware.rb

rule compile_test
  command = mkdir -p build && cc -std=c11 -Wall -Wextra -Werror -g -fsanitize=address,undefined -Isrc tests/test_bootstrap.c src/bootstrap.c -o $out
  description = Compile bootstrap failure-path checks

build build/test-bootstrap: compile_test tests/test_bootstrap.c src/bootstrap.c src/bootstrap.h

rule run_bootstrap_test
  command = ./build/test-bootstrap
  description = Verify RAM bootstrap transfer and failure handling
  pool = console

build test-bootstrap: run_bootstrap_test build/test-bootstrap
build test: phony test-firmware test-bootstrap test-frame test-mode test-transport test-viewer

rule audit_firmware
  command = ruby tools/extract_firmware.rb vendor/vga2usb_bins.o_shipped build/firmware
  description = Extract and audit the pinned original VGA2USB firmware
  pool = console

build firmware-audit: audit_firmware tools/extract_firmware.rb tools/vendor_firmware.rb

rule render_firmware
  command = ruby tools/render_firmware.rb vendor/vga2usb_bins.o_shipped $out
  description = Render hash-verified original-model RAM firmware

build build/firmware.h: render_firmware vendor/vga2usb_bins.o_shipped tools/vendor_firmware.rb tools/render_firmware.rb

rule compile_driver
  command = cc -std=c11 -Wall -Wextra -Werror -g -Isrc -Ibuild src/main.c src/bootstrap.c src/capture.c src/capture_mode.c src/home_frame.c src/source_watch.c $$(pkg-config --cflags --libs libusb-1.0) -o $out
  description = Build native original VGA2USB bringup tool

build build/vga2usb-native: compile_driver src/main.c src/bootstrap.c src/bootstrap.h src/capture.c src/capture.h src/capture_mode.c src/capture_mode.h src/home_frame.c src/home_frame.h src/source_watch.c src/source_watch.h build/firmware.h
build driver: phony build/vga2usb-native

default test

rule compile_frame_test
  command = mkdir -p build && cc -std=c11 -Wall -Wextra -Werror -g -fsanitize=address,undefined -Isrc tests/test_home_frame.c src/home_frame.c -o $out
  description = Compile HOME frame decoder checks

build build/test-home-frame: compile_frame_test tests/test_home_frame.c src/home_frame.c src/home_frame.h

rule run_frame_test
  command = ./build/test-home-frame
  description = Verify original HOME frame segmentation and deordering
  pool = console

build test-frame: run_frame_test build/test-home-frame

rule compile_mode_test
  command = mkdir -p build && cc -std=c11 -Wall -Wextra -Werror -g -fsanitize=address,undefined -Isrc tests/test_capture_mode.c src/capture_mode.c src/home_frame.c -o $out
  description = Compile original capture-mode request checks

build build/test-capture-mode: compile_mode_test tests/test_capture_mode.c src/capture_mode.c src/capture_mode.h src/home_frame.c

rule run_mode_test
  command = ./build/test-capture-mode
  description = Verify original ADC overrides and complete VGA capture requests
  pool = console

build test-mode: run_mode_test build/test-capture-mode

rule compile_transport_test
  command = mkdir -p build && cc -std=c11 -Wall -Wextra -Werror -g -fsanitize=address,undefined -Isrc $$(pkg-config --cflags libusb-1.0) tests/test_capture_transport.c src/capture.c src/capture_mode.c src/home_frame.c src/source_watch.c -o $out
  description = Compile async capture transport failure checks

build build/test-capture-transport: compile_transport_test tests/test_capture_transport.c src/capture.c src/capture_mode.c src/home_frame.c src/source_watch.c src/capture.h src/capture_mode.h src/home_frame.h src/source_watch.h

rule run_transport_test
  command = ./build/test-capture-transport
  description = Verify USB queue ordering and reject incomplete frames
  pool = console

build test-transport: run_transport_test build/test-capture-transport

rule viewer_test
  command = ruby tests/test_viewer_stream.rb
  description = Verify complete live-viewer frame packets in both VGA modes
  pool = console
build test-viewer: viewer_test tests/test_viewer_stream.rb tools/view-live.sh
